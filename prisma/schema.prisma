  updatedAt          DateTime            @updatedAt @map("updated_at")

  customer           Customer?           @relation(fields: [customerId], references: [id])
  assignedToUser     User?               @relation("RmaAssignedTo", fields: [assignedTo], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("rmas")
}

model OrderConfirmation {
