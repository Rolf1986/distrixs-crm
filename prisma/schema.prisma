model EmailAccount {
  id          String   @id @default(cuid())
  label       String                          // bijv. "Verkoop inbox"
  host        String                          // imap.gmail.com
  port        Int      @default(993)
  secure      Boolean  @default(true)
  username    String                          // email adres
  password    String                          // versleuteld opgeslagen
  lastSyncAt  DateTime? @map("last_sync_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  emails      Email[]

  @@map("email_accounts")
}

model Email {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  messageId     String   @map("message_id")   // RFC Message-ID header
  uid           Int?                           // IMAP UID
  subject       String
  fromAddress   String   @map("from_address")
  fromName      String?  @map("from_name")
  toAddresses   String   @map("to_addresses")  // JSON array
  ccAddresses   String?  @map("cc_addresses")
  bodyText      String?  @map("body_text")
  bodyHtml      String?  @map("body_html")
  snippet       String?                        // eerste ~200 tekens
  sentAt        DateTime @map("sent_at")
  isRead        Boolean  @default(false) @map("is_read")
  direction     String   @default("INBOUND")   // INBOUND | OUTBOUND
  // Koppelingen
  customerId    String?  @map("customer_id")
  dealId        String?  @map("deal_id")
  createdAt     DateTime @default(now()) @map("created_at")

  account       EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer      Customer?    @relation(fields: [customerId], references: [id])
  deal          Deal?        @relation(fields: [dealId], references: [id])

  @@unique([accountId, messageId])
  @@index([customerId])
  @@index([dealId])
  @@index([sentAt])
  @@map("emails")
}

